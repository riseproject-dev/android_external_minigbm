soong_namespace {}

cc_library_shared {
    name: "libgbm_mesa_wrapper",
    vendor: true,
    compile_multilib: "64",

    srcs: [
        "gbm_mesa_wrapper.c",
    ],

    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
        "-D_GNU_SOURCE=1",
    ],

    shared_libs: [
        "libcutils",
        "libdrm",
        "liblog",
    ] + select(soong_config_variable("minigbm", "mesa_module"), {
        any @ module: [module],
        default: [],
    }),

    header_libs: [
        "minigbm_headers",
    ],

    export_include_dirs: ["."],
}
